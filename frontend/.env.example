# Copia este archivo a .env y completa los valores.
# cp frontend/.env.example frontend/.env

# URL base de la API del backend Laravel
VITE_API_URL=http://localhost:8000

# URL del Laravel Echo Server (WebSockets)
VITE_ECHO_HOST=http://localhost:6001

# Clave de la API de Google Maps (Maps JavaScript API + Places API)
# Restringir por referer (HTTP referrers) y por API en Google Cloud Console.
VITE_GOOGLE_MAPS_KEY=
